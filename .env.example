# PostgreSQL connection (must have pgvector extension enabled)
DATABASE_URL="postgresql://postgres:password@localhost:5432/recipebank?schema=public"

# JWT signing secret (generate with: openssl rand -base64 32)
JWT_SECRET="change-me-to-a-random-secret"

# OpenAI API key for recipe import AI and embedding generation
OPENAI_API_KEY="sk-..."

# App URL (used for password reset links)
APP_URL="http://localhost:3000"

# Email service (for password reset & email verification)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="noreply@recipebank.app"
